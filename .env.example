# Railway Postgres
DATABASE_URL=

# Required for SEC requests. Use a real contact address per SEC guidance.
SEC_USER_AGENT=JARVIS/0.1 contact@example.com

# Live stock market snapshot provider. If absent, stock sightings are preserved but alpha-ineligible.
TIINGO_API_KEY=

# Crypto anomaly observation trigger from the Mythos design. This is a research trigger, NOT a trade or safety gate.
CRYPTO_ANOMALY_Z_TRIGGER=2

# Service controls
ENABLE_HOURLY_SCAN=false
RUN_SYSTEM_UPDATE_SECRET=
PORT=3000
TZ=America/Chicago
